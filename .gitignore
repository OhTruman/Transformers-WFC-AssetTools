# tool binaries / downloads (fetched by setup_tools.ps1)
bin/
_downloads/
logs/
__pycache__/
*.pyc
# large generated databases and caches (rebuild with run_pipeline.py / authored_db_safe.py)
manifests/*.db
manifests/authored_shards/
manifests/packages/
manifests/extracted/
manifests/assets.json
manifests/files.json
manifests/packages.json
manifests/schema.json
manifests/high_value.json
manifests/maps.json

# large local outputs (DDS mirror of ExtractedAssets PNGs: texture_dds.py)
out/
cache/
backups/
# downloaded model weights / licence copies (listed with sha256 in manifests/hd/e_models.json)
work/models/*
!work/models/pip_constraints.txt
!work/models/_manifest.py
